# ============================================================
# DARIO - Variables de Entorno para Produccion
# ============================================================
# Copia este archivo como .env.production y rellena los valores.
# NUNCA subas .env.production a git.
#
# Uso:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Genera un JWT_SECRET seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Genera un DB_PASSWORD seguro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# --- BACKEND ---
PORT=3000
NODE_ENV=production
JWT_SECRET=REEMPLAZAR_CON_SECRET_LARGO_64_CHARS
JWT_EXPIRES_IN=7d

# --- BASE DE DATOS ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE
DB_NAME=DARIO
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REEMPLAZAR_CON_PASSWORD_REDIS
REDIS_TLS=false

# --- CORS (dominios permitidos, separados por coma) ---
CORS_ORIGINS=https://tudominio.com
FRONTEND_URL=https://tudominio.com

# --- OPENAI ---
OPENAI_API_KEY=sk-REEMPLAZAR_CON_TU_API_KEY

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=https://api.tudominio.com/api/integraciones/google/callback

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail
SMTP_FROM=noreply@tudominio.com

# --- TWILIO (WhatsApp) ---
TWILIO_ACCOUNT_SID=tu-twilio-account-sid
TWILIO_AUTH_TOKEN=tu-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- LOGGING ---
LOG_LEVEL=info

# --- PUERTOS (solo si necesitas cambiar los defaults) ---
HTTP_PORT=80
