# ============================================================
# DARIO - Backend - Variables de Entorno (Desarrollo)
# ============================================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env a git.
# ============================================================

# --- BACKEND ---
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret-key-cambiar-en-produccion
JWT_EXPIRES_IN=1d

# --- BASE DE DATOS ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=DARIO
DB_POOL_MAX=20
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# --- CORS (dominios permitidos, separados por coma) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- OPENAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/integraciones/google/callback

# --- SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@dario.app

# --- TWILIO (WhatsApp) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- LOGGING ---
LOG_LEVEL=debug
